{
  "expo": {
    "name": "RouteX",
    "slug": "DzExpress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dzexpress",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RouteX utilise ta position pour centrer la carte pendant tes livraisons.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RouteX utilise ta position pour le suivi des livraisons.",
        "NSMicrophoneUsageDescription": "RouteX peut utiliser le micro pour les messages vocaux.",
        "NSPhotoLibraryUsageDescription": "RouteX accède à ta galerie pour joindre des photos à tes livraisons.",
        "NSCameraUsageDescription": "RouteX utilise la caméra pour prendre des photos de livraison."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.hdellys.DzExpress"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "RouteX peut utiliser le micro pour les messages vocaux."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RouteX accède à ta galerie pour joindre des photos.",
          "cameraPermission": "RouteX utilise la caméra pour les photos de livraison."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RouteX utilise ta position pour centrer la carte pendant tes livraisons.",
          "locationAlwaysAndWhenInUsePermission": "RouteX utilise ta position pour le suivi des livraisons.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      "expo-font",
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
